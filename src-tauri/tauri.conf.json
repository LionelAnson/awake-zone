{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Day",
  "version": "0.4.6",
  "identifier": "com.personalday.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "个人时钟 / Personal Day",
        "width": 240,
        "height": 128,
        "minWidth": 160,
        "minHeight": 128,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "个人时钟 · 设置",
        "url": "index.html?settings=1",
        "width": 340,
        "height": 550,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "个人时钟 / Personal Day",
    "longDescription": "按北京时间和计划作息，将一次清醒时段映射为个人时间 00:00—24:00。",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
